    given-names: "Sri"
  - family-names: "Subekti"
    given-names: "Ginanjar"

repository-code: "https://github.com/sriatikah51/criteria-review-retrieval"

keywords:
  - information retrieval
  - reciprocal rank fusion
  - hybrid retrieval
  - document chunking
  - retrieval augmented generation
  - evaluation metrics

references:
